<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_warranty_coverage" model="ir.sequence">
        <field name="name">Warranty Coverage</field>
        <field name="code">warranty_mgmt.coverage</field>
        <field name="prefix">WAR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_warranty_claim" model="ir.sequence">
        <field name="name">Warranty Claim</field>
        <field name="code">warranty_mgmt.claim</field>
        <field name="prefix">CLM/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
