<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_view_form_warranty" model="ir.ui.view">
        <field name="name">purchase.order.form.warranty</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Vendor warranties are given from the vendor bill, so the order only
                 shows what was already granted for its products. -->
            <div name="button_box" position="inside">
                <button class="oe_stat_button"
                        name="action_view_warranty_coverages"
                        icon="fa-shield"
                        type="object"
                        invisible="warranty_coverage_count == 0"
                        groups="warranty_mgmt.group_warranty_user">
                    <field name="warranty_coverage_count" string="Warranties" widget="statinfo"/>
                </button>
            </div>

        </field>
    </record>
</odoo>
