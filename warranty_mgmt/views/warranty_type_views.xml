<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warranty_type_list" model="ir.ui.view">
        <field name="name">warranty.type.list</field>
        <field name="model">warranty.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_warranty_type_form" model="ir.ui.view">
        <field name="name">warranty.type.form</field>
        <field name="model">warranty.type</field>
        <field name="arch" type="xml">
            <form string="Warranty Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_warranty_type_search" model="ir.ui.view">
        <field name="name">warranty.type.search</field>
        <field name="model">warranty.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_warranty_type" model="ir.actions.act_window">
        <field name="name">Warranty Types</field>
        <field name="res_model">warranty.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_warranty_type_search"/>
    </record>
</odoo>
