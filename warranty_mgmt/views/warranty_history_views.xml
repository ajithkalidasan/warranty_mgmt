<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warranty_history_list" model="ir.ui.view">
        <field name="name">warranty.history.list</field>
        <field name="model">warranty.history</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="event_date"/>
                <field name="coverage_id"/>
                <field name="event"/>
                <field name="user_id"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_warranty_history_form" model="ir.ui.view">
        <field name="name">warranty.history.form</field>
        <field name="model">warranty.history</field>
        <field name="arch" type="xml">
            <form string="Warranty History" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="coverage_id" readonly="1"/>
                            <field name="event" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="event_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_warranty_history_search" model="ir.ui.view">
        <field name="name">warranty.history.search</field>
        <field name="model">warranty.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="coverage_id"/>
                <field name="event"/>
                <field name="user_id"/>
                <field name="event_date"/>

                <filter name="today" string="Today" domain="[('event_date', '&gt;=', context_today())]"/>

                <group>
                    <filter name="group_coverage" string="Coverage" context="{'group_by': 'coverage_id'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_event" string="Event" context="{'group_by': 'event'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_warranty_history" model="ir.actions.act_window">
        <field name="name">Warranty History</field>
        <field name="res_model">warranty.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_warranty_history_search"/>
    </record>
</odoo>
