<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warranty_policy_list" model="ir.ui.view">
        <field name="name">warranty.policy.list</field>
        <field name="model">warranty.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="warranty_type_id"/>
                <field name="duration"/>
                <field name="duration_unit"/>
                <field name="start_from"/>
                <field name="apply_on"/>
                <field name="auto_create"/>
                <field name="reminder_days"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_warranty_policy_form" model="ir.ui.view">
        <field name="name">warranty.policy.form</field>
        <field name="model">warranty.policy</field>
        <field name="arch" type="xml">
            <form string="Warranty Policy">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="warranty_type_id"/>
                            <field name="active"/>
                            <field name="auto_create"/>
                        </group>
                        <group>
                            <field name="duration"/>
                            <field name="duration_unit"/>
                            <field name="start_from"/>
                            <field name="apply_on"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="allow_multiple_claims"/>
                            <field name="max_claims"/>
                            <field name="grace_days"/>
                            <field name="reminder_days"/>
                        </group>
                        <group>
                            <field name="product_ids" widget="many2many_tags" invisible="apply_on != 'product'"/>
                            <field name="category_ids" widget="many2many_tags" invisible="apply_on != 'category'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Coverage">
                            <field name="covered_items" placeholder="Covered items, conditions, and inclusions"/>
                        </page>
                        <page string="Exclusions">
                            <field name="exclusion_items" placeholder="Exclusions, limitations, and exceptions"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_warranty_policy_search" model="ir.ui.view">
        <field name="name">warranty.policy.search</field>
        <field name="model">warranty.policy</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="warranty_type_id"/>
                <field name="apply_on"/>
                <field name="start_from"/>
                <filter name="auto_create" string="Automatic" domain="[('auto_create', '=', True)]"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_warranty_policy" model="ir.actions.act_window">
        <field name="name">Warranty Policies</field>
        <field name="res_model">warranty.policy</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_warranty_policy_search"/>
    </record>
</odoo>
